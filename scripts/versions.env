# Pinned versions for a reproducible lab. Sourced by scripts/platform.sh and scripts/lab.sh.
# Change a value here, not in the scripts. scripts/check-versions.sh lists newer upstream releases.
# Last refreshed: 2026-10-11 (latest stable of each at that date).

# Host tools not packaged by Ubuntu, installed by scripts/platform.sh only when missing
# (Docker and python3 come from Ubuntu's packages)
K3D_VERSION=v5.9.0
KUBECTL_VERSION=v1.37.1
HELM_VERSION=v4.3.0

# Cluster (k3d runs each k3s node as a container: 1 server + 1 agent + 1 drain node)
CLUSTER=ai1-tasks
K3S_IMAGE=docker.io/rancher/k3s:v1.37.1-k3s1

# Build and runtime base images, pinned by digest (Cargo.lock is used with --locked)
RUST_IMAGE=docker.io/library/rust:1.99.0-trixie@sha256:6ff07edce8775d0f64be7aba9197229407301bddf2054d62c27b541a6238a181
DEBIAN_IMAGE=docker.io/library/debian:trixie-20261005-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f

# Third-party runtime images (pulled, then imported into k3d)
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.0
PYTHON_IMAGE=docker.io/library/python:3.14.8-slim-trixie
AGW_IMAGE=ghcr.io/agentgateway/agentgateway:v1.6.0

# Images built from this repository (scripts/lab.sh passes every image reference to the Helm chart)
TASK_SERVER_IMAGE=localhost/ai1-task-server:0.3.1
SEAL_PROXY_IMAGE=localhost/ai1-seal-proxy:0.3.0
OFFICIAL_P0_IMAGE=localhost/ai1-official-p0:0.1.0
EXT_SEAL_IMAGE=localhost/ai1-ext-seal:0.1.0

# Optional: agentgateway built from the unmerged PR #2995 (slow: about 25 min on 20 cores)
AGW_PR2995_REPO=https://github.com/stevenctl/agentgateway.git
AGW_PR2995_SHA=2bc5d041b090
AGW_PR2995_IMAGE=localhost/agentgateway:pr2995-2bc5d041

# Runtime image for the ExtMcp sealing processor (P-agw-2995). The binary is built beforehand inside
# the RUST_IMAGE of scripts/versions.env by scripts/lab.sh build (cargo build --release; protobuf-compiler installed) and copied to dist/.
ARG BASE=docker.io/library/debian:trixie-slim
FROM ${BASE}
COPY dist/ext-seal /usr/local/bin/ext-seal
USER 65532
EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/ext-seal"]
